<!---
	The BxORM landing page, selected by src/index.md's `layout: home`. The head and the shell are written here, the look is
	assets/home.css and the behavior is assets/home.js. The whole page is hand written: index.md's Markdown body is not used.
	A literal `#` is written `##` because this file is interpolated. Links to the docs point at the GitBook 2.x docs.
--->
<bx:include template="includes/site-helpers.bxm">
<bx:script>
	variables.siteUrl = reReplace( variables.siteConfig.baseURL ?: "https://bxorm.boxlang.io/", "/*$", "/" )
	variables.pageTitle = "BxORM: the ORM framework for BoxLang"
	variables.pageDesc = variables.siteConfig.description ?: ""
	variables.faviconUrl = trim( variables.siteConfig.theme.favicon ?: "" )
</bx:script>
<bx:output>
<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>#encodeForHTML( variables.pageTitle )#</title>
<meta name="description" content="#encodeForHTML( variables.pageDesc )#">
<meta name="theme-color" content="##001510">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="#variables.siteUrl#">
<meta property="og:type" content="website">
<meta property="og:site_name" content="BxORM">
<meta property="og:title" content="#encodeForHTML( variables.pageTitle )#">
<meta property="og:description" content="#encodeForHTML( variables.pageDesc )#">
<meta property="og:url" content="#variables.siteUrl#">
<meta property="og:image" content="#variables.siteUrl#assets/bxorm-logo.png">
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@TryBoxLang">
<meta name="twitter:title" content="#encodeForHTML( variables.pageTitle )#">
<meta name="twitter:description" content="#encodeForHTML( variables.pageDesc )#">
<bx:if len( variables.faviconUrl )>
<link rel="icon" href="#resolveAssetUrl( variables.faviconUrl )#">
</bx:if>
<script>
	( function () {
		var stored = null;
		try { stored = localStorage.getItem( "bxsites-theme" ); } catch ( e ) {}
		document.documentElement.setAttribute( "data-theme", stored === "light" ? "light" : "dark" );
	} )();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/duotone/style.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="#themeAssetUrl( 'home.css' )#">
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "BxORM",
	"applicationCategory": "DeveloperApplication",
	"operatingSystem": "Linux, macOS, Windows",
	"description": "#encodeForJavaScript( variables.pageDesc )#",
	"url": "#variables.siteUrl#",
	"license": "https://www.apache.org/licenses/LICENSE-2.0",
	"codeRepository": "https://github.com/ortus-boxlang/bx-orm",
	"programmingLanguage": "BoxLang",
	"offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
	"author": { "@type": "Organization", "name": "Ortus Solutions, Corp", "url": "https://www.ortussolutions.com" }
}
</script>
</head>
<body>


<header class="top">
  <div class="wrap">
    <a class="brand" href="#variables.basePath#"><img src="#variables.basePath#assets/bxorm-logo.png" alt="">BxORM</a>
    <nav class="main">
      <a href="https://bxorm.ortusbooks.com/bxorm-2.x/">Docs</a><a href="https://bxorm.ortusbooks.com/bxorm-2.x/getting-started/quick-start">Quick Start</a><a href="#variables.basePath#course/">Course</a><a href="https://bxorm.ortusbooks.com/bxorm-2.x/working-with-entities/criteria">Criteria</a><a href="https://bxorm.ortusbooks.com/bxorm-2.x/advanced/performance##boot-cache">Boot Cache</a><a href="https://bxorm.ortusbooks.com/bxorm-2.x/release-history/whats-new-2.0.0">What's New</a>
    </nav>
    <div class="spacer"></div>
    <a class="search" href="https://bxorm.ortusbooks.com/bxorm-2.x/"><i class="ph-duotone ph-magnifying-glass"></i>Search the docs</a>
    <button type="button" class="icon-btn" id="themebtn" aria-label="Toggle dark mode" title="Toggle dark mode"><i class="ph-duotone ph-sun"></i></button>
    <a class="icon-btn" href="https://github.com/ortus-boxlang/bx-orm" aria-label="BxORM on GitHub"><i class="ph-duotone ph-github-logo"></i>Star</a>
  </div>
</header>

<!-- 1. HERO -->
<div class="hero">
  <div class="aurora"></div>
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">Hibernate 7.4, made dynamic</span>
      <h1>Your tables,<br>as <span class="grad">BoxLang classes</span>.</h1>
      <p class="lead">BxORM is a <strong>whole framework on top of Hibernate</strong>, built for a dynamic language. Write a class, get a table. Then <strong>save, load and query rows as objects</strong> with static helpers, fluent criteria, automatic type conversion and errors written for humans. No XML, no Java classes, no casting.</p>
      <div class="install"><span class="prompt">$</span><code>bx-module install bx-orm</code><button type="button" data-copy="bx-module install bx-orm">Copy</button></div>
      <div class="actions">
        <a class="btn btn-primary" href="https://bxorm.ortusbooks.com/bxorm-2.x/getting-started/quick-start">Get started <i class="ph-duotone ph-arrow-right"></i></a>
        <a class="btn btn-ghost" href="https://bxorm.ortusbooks.com/bxorm-2.x/"><i class="ph-duotone ph-book-open-text"></i>Read the docs</a>
      </div>
      <ul class="trust">
        <li><b>47</b> BIFs</li><li><b>Hibernate</b> 7.4.8.Final</li><li><b>~2x</b> faster boots on large models</li><li><b>Open source</b></li>
      </ul>
    </div>

    <div class="stage-wrap">
      <div class="float f1"><i class="ph-duotone ph-lightning"></i>Static helpers on every entity</div>
      <div class="stage">
        <div class="stage-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <div class="tabs" data-group="hero">
            <button class="on" data-t="h1">User.bx</button>
            <button data-t="h2">static.bxs</button>
            <button data-t="h3">criteria.bxs</button>
          </div>
        </div>
<pre class="code" id="h1" style="min-height:330px;max-height:520px"><span class="c">// models/User.bx: one class, one table. That's the mapping.</span>
<span class="f">@persistent</span>
<span class="f">@table</span>( <span class="s">"users"</span> )
<span class="f">@softDelete</span>
<span class="k">class</span> {

    <span class="f">@fieldtype</span>( <span class="s">"id"</span> )
    <span class="f">@generator</span>( <span class="s">"native"</span> )
    <span class="k">property</span> id;

    <span class="f">@ormtype</span>( <span class="s">"string"</span> )
    <span class="f">@unique</span>
    <span class="k">property</span> email;

    <span class="f">@ormtype</span>( <span class="s">"timestamp"</span> )
    <span class="f">@autoTimestamp</span>( <span class="s">"create"</span> )
    <span class="k">property</span> createdDate;

    <span class="f">@fieldtype</span>( <span class="s">"one-to-many"</span> )
    <span class="f">@cfc</span>( <span class="s">"Order"</span> )
    <span class="f">@fkcolumn</span>( <span class="s">"userID"</span> )
    <span class="k">property</span> orders;

    <span class="k">function</span> <span class="f">postCommit</span>( entity, action ){
        <span class="c">// only after a real commit: send the welcome email</span>
    }
}</pre>
<pre class="code" id="h2" hidden style="min-height:330px;max-height:520px"><span class="c">// No service layer, no base class: the entity is the API</span>
user  = User::<span class="f">getOrFail</span>( rc.id );        <span class="c">// "42" from the URL? fine</span>
admin = User::<span class="f">findWhere</span>( { email : <span class="s">"admin@example.com"</span> } );
total = User::<span class="f">count</span>( { active : <span class="k">true</span> } );
page  = User::<span class="f">list</span>( { max : <span class="n">25</span>, offset : <span class="n">50</span>, sort : <span class="s">"email"</span> } );
tag   = Tag::<span class="f">firstOrCreate</span>( { name : rc.tag } );

<span class="k">transaction</span> {
    <span class="f">entitySave</span>( User::<span class="f">new</span>( { email : <span class="s">"ann@example.com"</span>, active : <span class="k">true</span> } ) );
}

<span class="c">// one UPDATE, no entities loaded</span>
User::<span class="f">updateWhere</span>( { active : <span class="k">false</span> }, { role : <span class="s">"guest"</span> } );</pre>
<pre class="code" id="h3" hidden style="min-height:330px;max-height:520px"><span class="c">// Fluent, checked, always parameterized</span>
fords = Vehicle::<span class="f">criteria</span>()
    .<span class="f">isEq</span>( <span class="s">"manufacturer.name"</span>, <span class="s">"Ford Motor Company"</span> )  <span class="c">// joined for you</span>
    .<span class="f">anyOf</span>( ( c ) =&gt; c.<span class="f">isGt</span>( <span class="s">"year"</span>, <span class="n">2020</span> ).<span class="f">isLt</span>( <span class="s">"price"</span>, <span class="n">20000</span> ) )
    .<span class="f">order</span>( <span class="s">"price"</span> )
    .<span class="f">asStruct</span>( <span class="s">"id,model,price,manufacturer.name"</span> )
    .<span class="f">paginate</span>( page = <span class="n">1</span>, maxRows = <span class="n">25</span> );

<span class="c">// Or HQL. Names are case-insensitive, like BoxLang.</span>
users = <span class="f">ormExecuteQuery</span>( <span class="s">"from user where firstname = ?"</span>, [ <span class="s">"Luis"</span> ] );</pre>
        <div class="stage-foot"><i class="ph-duotone ph-database"></i><span>Getters, setters and static methods are <b>generated</b> at startup</span></div>
      </div>
      <div class="float f2"><i class="ph-duotone ph-chat-circle-text"></i><span>Did you mean <code>[firstName]</code>?</span></div>
    </div>
  </div>
</div>

<div class="marquee"><div class="row"><span><i class="ph-duotone ph-cube"></i>Entities</span><span><i class="ph-duotone ph-tree-structure"></i>Relationships</span><span><i class="ph-duotone ph-lightning"></i>Static helpers</span><span><i class="ph-duotone ph-funnel"></i>Criteria</span><span><i class="ph-duotone ph-code"></i>Case-insensitive HQL</span><span><i class="ph-duotone ph-arrows-left-right"></i>No casting</span><span><i class="ph-duotone ph-arrows-clockwise"></i>Transactions</span><span><i class="ph-duotone ph-bell-ringing"></i>Entity events</span><span><i class="ph-duotone ph-stack"></i>BoxCache second-level cache</span><span><i class="ph-duotone ph-trash"></i>Soft delete</span><span><i class="ph-duotone ph-clock"></i>Timestamps</span><span><i class="ph-duotone ph-lock"></i>Locking</span><span><i class="ph-duotone ph-brackets-curly"></i>entityToStruct()</span><span><i class="ph-duotone ph-chat-circle-text"></i>Human errors</span><span><i class="ph-duotone ph-rocket-launch"></i>Boot cache</span><span><i class="ph-duotone ph-pulse"></i>Observability</span><span><i class="ph-duotone ph-cube"></i>Entities</span><span><i class="ph-duotone ph-tree-structure"></i>Relationships</span><span><i class="ph-duotone ph-lightning"></i>Static helpers</span><span><i class="ph-duotone ph-funnel"></i>Criteria</span><span><i class="ph-duotone ph-code"></i>Case-insensitive HQL</span><span><i class="ph-duotone ph-arrows-left-right"></i>No casting</span><span><i class="ph-duotone ph-arrows-clockwise"></i>Transactions</span><span><i class="ph-duotone ph-bell-ringing"></i>Entity events</span><span><i class="ph-duotone ph-stack"></i>BoxCache second-level cache</span><span><i class="ph-duotone ph-trash"></i>Soft delete</span><span><i class="ph-duotone ph-clock"></i>Timestamps</span><span><i class="ph-duotone ph-lock"></i>Locking</span><span><i class="ph-duotone ph-brackets-curly"></i>entityToStruct()</span><span><i class="ph-duotone ph-chat-circle-text"></i>Human errors</span><span><i class="ph-duotone ph-rocket-launch"></i>Boot cache</span><span><i class="ph-duotone ph-pulse"></i>Observability</span></div></div>

<!-- 2. FRAMEWORK ON TOP OF HIBERNATE -->
<section>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">Not a thin wrapper</span>
      <h2>A whole framework between you <span class="grad">and Hibernate</span>.</h2>
      <p>Hibernate was built for static Java classes, XML mappings and typed parameters. BxORM does all the translation, so a dynamic language gets the whole engine and none of the ceremony.</p>
    </div>

    <div class="arch">
      <div class="col">
        <h3>You write</h3>
        <div class="chip"><i class="ph-duotone ph-file-code"></i>models/User.bx</div>
        <div class="chip"><i class="ph-duotone ph-lightning"></i>User::get( id )</div>
        <div class="chip typing"><i class="ph-duotone ph-pencil-simple-line"></i><span><span class="tw">entityCriteria( "User" )</span></span></div>
        <div class="chip"><i class="ph-duotone ph-code"></i>ormExecuteQuery()</div>
        <div class="chip"><i class="ph-duotone ph-arrows-clockwise"></i>transaction{}</div>
        <div class="chip"><i class="ph-duotone ph-warning-circle"></i>catch( "orm.*" )</div>
        <div class="pen"><i class="ph-duotone ph-pen-nib"></i>Plain BoxLang. Nothing else.</div>
      </div>
      <div class="pipe"><span></span><span></span><span></span></div>
      <div class="col core">
        <h3><img src="#variables.basePath#assets/bxorm-logo.png" alt="">BxORM does</h3>
        <div class="tiles"><div class="tile"><i class="ph-duotone ph-cube"></i><div><b>Mapping generation</b><small>Classes become Hibernate mappings, in memory</small></div></div><div class="tile"><i class="ph-duotone ph-file-code"></i><div><b>Generated entity classes</b><small>A Java facade per entity: every id generator, inheritance</small></div></div><div class="tile"><i class="ph-duotone ph-arrows-left-right"></i><div><b>Type conversion</b><small>BoxLang values to JDBC types and back</small></div></div><div class="tile"><i class="ph-duotone ph-text-aa"></i><div><b>Case-insensitive HQL</b><small><code>firstname</code> finds <code>firstName</code></small></div></div><div class="tile"><i class="ph-duotone ph-lightning"></i><div><b>Static helpers</b><small><code>User::get()</code> on every entity</small></div></div><div class="tile"><i class="ph-duotone ph-funnel"></i><div><b>Criteria builder</b><small>Fluent, checked, always parameterized</small></div></div><div class="tile"><i class="ph-duotone ph-bell-ringing"></i><div><b>Entity events</b><small><code>preInsert</code>, <code>postCommit</code>, veto</small></div></div><div class="tile"><i class="ph-duotone ph-chat-circle-text"></i><div><b>Human errors</b><small><code>orm.*</code> types with the fix</small></div></div><div class="tile"><i class="ph-duotone ph-arrows-clockwise"></i><div><b>Transactions</b><small>On BoxLang's <code>transaction{}</code></small></div></div><div class="tile"><i class="ph-duotone ph-stack"></i><div><b>Second-level cache</b><small>Every region is a BoxCache</small></div></div><div class="tile"><i class="ph-duotone ph-rocket-launch"></i><div><b>Boot cache</b><small>Skip parsing in production</small></div></div><div class="tile"><i class="ph-duotone ph-pulse"></i><div><b>Observability</b><small><code>onORMQuery</code>, <code>onORMFlush</code> events</small></div></div></div>
      </div>
      <div class="pipe"><span></span><span></span><span></span></div>
      <div class="stack">
        <div class="col hib"><h3>Engine</h3><div class="hibl"><svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M5.365 0L9.98 7.994h8.95L14.31 0H5.366zm-.431.248L.46 7.994l4.613 8.008L9.55 8.24 4.934.248zm13.992 7.75l-4.475 7.76 4.617 7.992 4.471-7.744-4.613-8.008zm-4.905 8.006l-8.95.002L9.688 24h8.946l-4.615-7.994.001-.002Z"/></svg><b>Hibernate ORM</b></div><small>7.4.8.Final: the query engine, dialects and sessions</small></div>
        <div class="col hib"><h3>Database</h3>Any JDBC database<div class="dblogos"><span><svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M16.405 5.501c-.115 0-.193.014-.274.033v.013h.014c.054.104.146.18.214.273.054.107.1.214.154.32l.014-.015c.094-.066.14-.172.14-.333-.04-.047-.046-.094-.08-.14-.04-.067-.126-.1-.18-.153zM5.77 18.695h-.927a50.854 50.854 0 00-.27-4.41h-.008l-1.41 4.41H2.45l-1.4-4.41h-.01a72.892 72.892 0 00-.195 4.41H0c.055-1.966.192-3.81.41-5.53h1.15l1.335 4.064h.008l1.347-4.064h1.095c.242 2.015.384 3.86.428 5.53zm4.017-4.08c-.378 2.045-.876 3.533-1.492 4.46-.482.716-1.01 1.073-1.583 1.073-.153 0-.34-.046-.566-.138v-.494c.11.017.24.026.386.026.268 0 .483-.075.647-.222.197-.18.295-.382.295-.605 0-.155-.077-.47-.23-.944L6.23 14.615h.91l.727 2.36c.164.536.233.91.205 1.123.4-1.064.678-2.227.835-3.483zm12.325 4.08h-2.63v-5.53h.885v4.85h1.745zm-3.32.135l-1.016-.5c.09-.076.177-.158.255-.25.433-.506.648-1.258.648-2.253 0-1.83-.718-2.746-2.155-2.746-.704 0-1.254.232-1.65.697-.43.508-.646 1.256-.646 2.245 0 .972.19 1.686.574 2.14.35.41.877.615 1.583.615.264 0 .506-.033.725-.098l1.325.772.36-.622zM15.5 17.588c-.225-.36-.337-.94-.337-1.736 0-1.393.424-2.09 1.27-2.09.443 0 .77.167.977.5.224.362.336.936.336 1.723 0 1.404-.424 2.108-1.27 2.108-.445 0-.77-.167-.978-.5zm-1.658-.425c0 .47-.172.856-.516 1.156-.344.3-.803.45-1.384.45-.543 0-1.064-.172-1.573-.515l.237-.476c.438.22.833.328 1.19.328.332 0 .593-.073.783-.22a.754.754 0 00.3-.615c0-.33-.23-.61-.648-.845-.388-.213-1.163-.657-1.163-.657-.422-.307-.632-.636-.632-1.177 0-.45.157-.81.47-1.085.315-.278.72-.415 1.22-.415.512 0 .98.136 1.4.41l-.213.476a2.726 2.726 0 00-1.064-.23c-.283 0-.502.068-.654.206a.685.685 0 00-.248.524c0 .328.234.61.666.85.393.215 1.187.67 1.187.67.433.305.648.63.648 1.168zm9.382-5.852c-.535-.014-.95.04-1.297.188-.1.04-.26.04-.274.167.055.053.063.14.11.214.08.134.218.313.346.407.14.11.28.216.427.31.26.16.555.255.81.416.145.094.293.213.44.313.073.05.12.14.214.172